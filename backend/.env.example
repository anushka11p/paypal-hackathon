# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox).
# Leave both empty to run with the built-in payment simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Groq: policy compiler, shopping agent, intent evaluator.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional per-role model overrides (default GROQ_MODEL):
# LEASH_AGENT_MODEL=
# LEASH_EVALUATOR_MODEL=
# LEASH_COMPILER_MODEL=

# Channel3 product search (used by the agent for live market prices).
CHANNEL3_API_KEY=

# Signs mandates (tamper-evidence). Any long random string.
MANDATE_SIGNING_SECRET=change-me

# Where PayPal returns the buyer after approval (this backend) and where the UI lives.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Set to "simulator" to use the built-in payment simulator even when PayPal keys are present.
# LEASH_PAYMENTS=simulator
