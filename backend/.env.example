# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox).
# Leave both empty to run with the built-in payment simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Claude: policy compiler, shopping agent, intent evaluator.
ANTHROPIC_API_KEY=
# Optional per-role model overrides (default claude-opus-5-5):
# LEASH_MODEL=
# LEASH_AGENT_MODEL=
# LEASH_EVALUATOR_MODEL=
# LEASH_COMPILER_MODEL=

# Channel3 product search (used by the agent for live market prices).
CHANNEL3_API_KEY=

# Signs mandates (tamper-evidence). Any long random string.
MANDATE_SIGNING_SECRET=change-me

# Where PayPal returns the buyer after approval (this backend) and where the UI lives.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
